// Google Gemini API অথবা OpenAI API Client Integration
const { GoogleGenerativeAI } = require('@google/generative-ai');

// env থেকে AI Key ব্যবহার করা হচ্ছে
const genAI = 
new GoogleGenerativeAI(process.env.AI_API_KEY || '');

// AI JSON Response Parsing Helper (Clean Markdown ```json formatting)
const cleanAndParseJSON = (text) => {
  try {
    const jsonMatch = text.match(/\{[\s\S]*\}|\[[\s\S]*\]/);
    if (jsonMatch) {
      return JSON.parse(jsonMatch[0]);
    }
    return JSON.parse(text);
  } catch (error) {
    throw new Error(
        'Failed to parse AI response into structured JSON format');
  }
};

// ১. AI CV Analysis Logic
exports.analyzeCVService = async (candidateData) => {
  const model = genAI.getGenerativeModel({ 
    model: 'gemini-1.5-flash' });

  const prompt = `
  You are an expert HR Specialist and ATS Engine. 
  Analyze the following candidate profile details and 
  provide feedback.
  
  Candidate Profile:
  ${JSON.stringify(candidateData)}

  Provide a structured JSON output with exact format:
  {
    "overallScore": 85,
    "strengths": ["Strength 1", "Strength 2"],
    "weaknesses": ["Weakness 1", "Weakness 2"],
    "suggestions": ["Suggestion 1", "Suggestion 2"]
  }
  Respond strictly in valid JSON format.
  `;

  const result = await model.generateContent(prompt);
  const response = await result.response;
  return cleanAndParseJSON(response.text());
};

// ২. CV -> Job Matcher Engine
exports.matchJobService = async 
(candidateSkills, jobRequirements) => {
  const model = genAI.getGenerativeModel({ 
    model: 'gemini-1.5-flash' });

  const prompt = `
  Compare Candidate Skills against Job Requirements and 
  output a match percentage with skill breakdown.

  Candidate Skills: ${JSON.stringify(candidateSkills)}
  Job Requirements & Skills: ${JSON.stringify(jobRequirements)}

  Return strict JSON in this format:
  {
    "matchScore": 87,
    "matchingSkills": ["Skill 1", "Skill 2"],
    "missingSkills": ["Skill A", "Skill B"],
    "recommendation": "Strong candidate for this role."
  }
  `;

  const result = await model.generateContent(prompt);
  const response = await result.response;
  return cleanAndParseJSON(response.text());
};

